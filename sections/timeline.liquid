{{ 'timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<style>

/* Add animation on scroll */
.container {
  opacity: 0;
  transform: translateY(50px);
  transition: transform 0.5s ease-out, opacity 0.5s ease-out;
}

/* When the container is in view */
.container.show {
  opacity: 1;
  transform: translateY(0);
}

/* Ensuring timeline container is scrollable */
.timeline {
  overflow-x: hidden;
  overflow-y: auto;
  max-height: 80vh; /* Controls vertical height for scrolling */
}

.gradient {
  background: linear-gradient(180deg, #ff9f55, #ffffff);
}

/* Optional tweaks for responsive design */
@media screen and (max-width: 768px) {
  .timeline::after {
    left: 20px;
  }
  
  .container {
    width: 100%;
    padding-left: 60px;
    padding-right: 25px;
  }
  
  .container::after {
    left: 15px;
  }
  
  .left::before,
  .right::before {
    display: none;
  }
}


</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    
    <div class="timeline">
      <span class="default-line"></span>
      <span class="draw-line"></span>
              {% for block in section.blocks %}
               
                    <div class="container left">
                      <div class="content">
                        <h2 class="content-title">
                          {{ block.settings.leftTitle }}
                        </h2>
                        <p class="content-para">
                          {{ block.settings.leftContent }}
                        </p>
                      </div>
                    </div>
                
                    <div class="container right">
                      <div class="content">
                        <h2 class="content-title">
                          {{ block.settings.rightTitle }}
                        </h2>
                        <p class="content-para">
                          {{ block.settings.rightContent }}
                        </p>
                      </div>
                    </div>
                
              {% endfor %}
    </div>  
    
  </div>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
  // Function to detect when an element is in viewport
  function isInViewport(el) {
    const rect = el.getBoundingClientRect();
    return (
      rect.top >= 0 &&
      rect.left >= 0 &&
      rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
      rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
  }

  // Function to add "show" class to containers when in view
  function checkTimelineScroll() {
    const containers = document.querySelectorAll('.container');
    
    containers.forEach(container => {
      if (isInViewport(container)) {
        container.classList.add('show');
      }
    });
  }

  // Check on scroll
  window.addEventListener('scroll', checkTimelineScroll);
  
  // Initial check in case elements are in view on load
  checkTimelineScroll();
});

</script>



{% schema %}
  {
    "name": "Timeline",
    "class":"timeline",
    "settings": [
      {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36

{{ 'timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}



<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    
    <div class="timeline">
      <span class="default-line"></span>
      <span class="draw-line"></span>
              
      {% for block in section.blocks %}
        <!-- Left Timeline Block -->
        <div class="container left">
          <div class="content">
            {% if block.settings.leftTitle != 'blank' %}
            <h2 class="content-title">{{ block.settings.leftTitle }}</h2>
            {% endif %}
            {% if block.settings.leftContent != 'blank'%}
              <p class="content-para">{{ block.settings.leftContent }}</p>
            {% endif %}
          </div>
        </div>
        
        <!-- Right Timeline Block -->
        <div class="container right">
          <div class="content">
            {% if block.settings.rightTitle != 'blank' %}
            <h2 class="content-title">{{ block.settings.rightTitle }}</h2>
            {% endif %}
            {% if block.settings.rightContent != 'blank'%}
              <p class="content-para">{{ block.settings.rightContent }}</p>
            {% endif %}
            </div>
        </div>
      {% endfor %}
    </div>
    
  </div>
</div>



<script>
document.addEventListener('DOMContentLoaded', function() {
  const timeline = document.querySelector('.timeline');
  const drawLine = document.querySelector('.draw-line');
  
  // Function to detect if an element is in the viewport
  function isInViewport(el) {
    const rect = el.getBoundingClientRect();
    return (
      rect.top >= 0 &&
      rect.left >= 0 &&
      rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
      rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
  }

  // Function to check the visibility of timeline items on scroll
  function checkScroll() {
    const timelineItems = document.querySelectorAll('.container');
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const timelineHeight = timeline.offsetHeight;
    
    // Calculate the fill height of the draw-line as per the scroll
    const timelineTop = timeline.offsetTop;
    const lineHeight = (scrollTop - timelineTop) / timelineHeight * 100;
    const filledHeight = Math.min(Math.max(lineHeight, 0), 100);
    
    drawLine.style.height = `${filledHeight}%`;
    
    // Animate the dots and content
    timelineItems.forEach(item => {
      if (isInViewport(item)) {
        item.classList.add('show');
      }
    });
  }

  // Check timeline on scroll
  window.addEventListener('scroll', checkScroll);

  // Initial check on load
  checkScroll();
});

</script>



{% schema %}
  {
    "name": "Timeline",
    "class":"timeline",
    "settings": [
      {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
       {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info"
    }
    ],
    "blocks":[{
      "type": "text",
      "name": "Content section",
      "settings":[
        {
          "type":"header",
          "content":"Left Content"
        },
        {
          "type":"text",
          "id":"leftTitle",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"leftContent",
          "label":"Content"
        },
        {
          "type":"header",
          "content":"Right Content"
        },
        {
          "type":"text",
          "id":"rightTitle",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"rightContent",
          "label":"Content"
        }
      ]
    }],
    "presets":[{
      "name":"Timeline"
    }]
  }
{% endschema %}
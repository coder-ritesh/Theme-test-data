          "type":"text",
          "id":"rightTitle",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"rightContent",
          "label":"Content"
        }
      ]
    }],
    "presets":[{
      "name":"Timeline"
    }]
  }
{% endschema %}
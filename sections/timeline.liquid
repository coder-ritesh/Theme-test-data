          "type":"text",
          "id":"leftTitle",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"leftContent",
          "label":"Content"
        },
        {
          "type":"header",
          "content":"Right Content"
        },
        {
          "type":"text",
          "id":"rightTitle",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"rightContent",
          "label":"Content"
        }
      ]
    }],
    "presets":[{
      "name":"Timeline"
    }]
  }
{% endschema %}
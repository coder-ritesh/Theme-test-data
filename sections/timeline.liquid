{{ 'timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<style>
/* The actual timeline (the vertical ruler) */
.timeline {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  overflow-y: hidden;
}

/* Vertical line for the timeline */
.timeline::after {
  content: '';
  position: absolute;
  width: 6px;
  background-color: #FF9F55; /* Scroll color before filling */
  top: 0;
  bottom: 0;
  left: 50%;
  margin-left: -3px;
  z-index: 1;
}

.default-line {
  position: absolute;
  width: 6px;
  background-color: #e9ecef; /* Default grey line before scroll */
  top: 0;
  bottom: 0;
  left: 50%;
  margin-left: -3px;
  z-index: 0;
}

.draw-line {
  position: absolute;
  width: 6px;
  background-color: #FF9F55; /* Active fill color */
  top: 0;
  height: 0; /* Will change height based on scroll */
  left: 50%;
  margin-left: -3px;
  z-index: 1;
  transition: height 0.4s ease; /* Smooth transition for line fill */
}

/* Container around content */
.container {
  padding: 10px 40px;
  position: relative;
  background-color: inherit;
  width: 50%;
  opacity: 0;
  transform: translateY(50px);
  transition: transform 0.6s ease-out, opacity 0.6s ease-out;
}

/* Timeline circles */
.container::after {
  content: '';
  position: absolute;
  width: 25px;
  height: 25px;
  right: -17px;
  background-color: white;
  border: 4px solid #FF9F55;
  top: 15px;
  border-radius: 50%;
  z-index: 2;
  transition: width 0.6s ease, height 0.6s ease;
}

/* Growing circle when container is in view */
.show .container::after {
  width: 35px;
  height: 35px;
  right: -22px;
}

/* Left containers */
.left {
  left: 0;
}

/* Right containers */
.right {
  left: 50%;
}

/* Left container arrow */
.left::before {
  content: " ";
  height: 0;
  position: absolute;
  top: 22px;
  width: 0;
  z-index: 1;
  right: 30px;
  border: medium solid white;
  border-width: 10px 0 10px 10px;
  border-color: transparent transparent transparent white;
}

/* Right container arrow */
.right::before {
  content: " ";
  height: 0;
  position: absolute;
  top: 22px;
  width: 0;
  z-index: 1;
  left: 30px;
  border: medium solid white;
  border-width: 10px 10px 10px 0;
  border-color: transparent white transparent transparent;
}

/* Fix the circle for containers on the right side */
.right::after {
  left: -16px;
}

/* The content inside the timeline */
.content {
  padding: 20px 30px;
  background-color: white;
  position: relative;
  border-radius: 6px;
}

/* Animations when elements are visible */
.show {
  opacity: 1;
  transform: translateY(0);
}

/* Optional tweaks for smaller screens */
@media screen and (max-width: 768px) {
  .timeline::after {
    left: 31px;
  }
  
  .container {
    width: 100%;
    padding-left: 70px;
    padding-right: 25px;
  }
  
  .container::after {
    left: 20px;
  }
  
  .left::before,
  .right::before {
    display: none;
  }
  
  .right {
    left: 0;
  }
}
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    
    <div class="timeline">
      <span class="default-line"></span>
      <span class="draw-line"></span>
              
      {% for block in section.blocks %}
        <!-- Left Timeline Block -->
        <div class="container left">
          <div class="content">
            <h2 class="content-title">{{ block.settings.leftTitle }}</h2>
            <p class="content-para">{{ block.settings.leftContent }}</p>
          </div>
        </div>
        
        <!-- Right Timeline Block -->
        <div class="container right">
          <div class="content">
            <h2 class="content-title">{{ block.settings.rightTitle }}</h2>
            <p class="content-para">{{ block.settings.rightContent }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
    
  </div>
</div>



<script>
document.addEventListener('DOMContentLoaded', function() {
  const timeline = document.querySelector('.timeline');
  const drawLine = document.querySelector('.draw-line');
  
  // Function to detect if an element is in the viewport
  function isInViewport(el) {
    const rect = el.getBoundingClientRect();
    return (
      rect.top >= 0 &&
      rect.left >= 0 &&
      rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
      rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
  }

  // Function to check the visibility of timeline items on scroll
  function checkScroll() {
    const timelineItems = document.querySelectorAll('.container');
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const timelineHeight = timeline.offsetHeight;
    
    // Calculate the fill height of the draw-line as per the scroll
    const timelineTop = timeline.offsetTop;
    const lineHeight = (scrollTop - timelineTop) / timelineHeight * 100;
    const filledHeight = Math.min(Math.max(lineHeight, 0), 100);
    
    drawLine.style.height = `${filledHeight}%`;
    
    // Animate the dots and content
    timelineItems.forEach(item => {
      if (isInViewport(item)) {
        item.classList.add('show');
      }
    });
  }

  // Check timeline on scroll
  window.addEventListener('scroll', checkScroll);

  // Initial check on load
  checkScroll();
});

</script>



